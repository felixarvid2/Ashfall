{
  "name": "ashfall",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Ashfall \u2014 a dark sci-fi action RPG for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "meshy": "tsx scripts/meshy/cli.ts",
    "sim": "tsx scripts/sim/cli.ts",
    "play": "tsx scripts/sim/play.ts",
    "assets:check": "tsx scripts/assets/check.ts",
    "assets:export": "tsx scripts/assets/exportLibrary.ts",
    "region:report": "tsx scripts/sim/regionReport.ts",
    "build:artifact": "tsx scripts/artifact/build.ts",
    "vfx:generate": "NODE_USE_ENV_PROXY=1 tsx scripts/vfx/generate.ts",
    "vfx:pack": "tsx scripts/vfx/pack.ts",
    "art:generate": "NODE_USE_ENV_PROXY=1 tsx scripts/art/generate.ts",
    "art:process": "tsx scripts/art/process.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
