{
  "name": "ashfall",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Ashfall — a dark sci-fi action RPG for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --exclude tests/balance.test.ts",
    "meshy": "tsx scripts/meshy/cli.ts",
    "perf:quick": "PERF_QUICK=1 vitest run tests/perfBudget.test.ts",
    "perf:tick": "tsx scripts/perf/tick.ts",
    "sim": "tsx scripts/sim/cli.ts",
    "play": "tsx scripts/sim/play.ts",
    "balance:report": "tsx scripts/sim/balanceReport.ts",
    "balance:check": "BALANCE=1 vitest run tests/balance.test.ts",
    "fixtures:build": "tsx scripts/sim/fixtures.ts",
    "blender:build": "tsx scripts/blender/build.ts",
    "assets:check": "tsx scripts/assets/check.ts && tsx scripts/assets/textureCaps.ts",
    "assets:textures": "tsx scripts/assets/textureCaps.ts",
    "assets:strip-lods": "tsx scripts/assets/stripLodTextures.ts",
    "audio:build": "tsx scripts/audio/build.ts",
    "assets:export": "tsx scripts/assets/exportLibrary.ts",
    "assets:third-party": "NODE_USE_ENV_PROXY=1 tsx scripts/assets/thirdParty.ts",
    "region:report": "tsx scripts/sim/regionReport.ts",
    "build:artifact": "tsx scripts/artifact/build.ts",
    "build:android": "tsx scripts/android/build.ts",
    "vfx:generate": "NODE_USE_ENV_PROXY=1 tsx scripts/vfx/generate.ts",
    "vfx:pack": "tsx scripts/vfx/pack.ts",
    "art:generate": "NODE_USE_ENV_PROXY=1 tsx scripts/art/generate.ts",
    "art:process": "tsx scripts/art/process.ts",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "^21.0.4",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
